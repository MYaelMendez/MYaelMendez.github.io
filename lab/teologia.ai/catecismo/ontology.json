      "instances": [
        "Bautismo (agua)",
        "Santa Cena (pan y vino)"
      ]
    },
    "Confesión": {
      "es": "decir la verdad y recibir el perdón",
      "part": "Confesión y Absolución"
    },
    "Vocación": {
      "es": "cada rol cotidiano como lugar de servicio: familia, trabajo, ciudad",
