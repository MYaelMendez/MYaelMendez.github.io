-- 💡 cara foco · mæchlæng
-- BOCETO / SKETCH, NOT YET RUN
-- Basado en Mech (mech-lang.org) de Corey Montella, Apache-2.0. Sin afiliación.
-- El Asimov 1 no tiene cara; el foco se la da. El filamento es una sola línea:
-- en reposo dibuja >_ ; con evidencia se transforma en ojos y boca.

<mood> := :hold | :lost | :tired | :sleep | :think | :ready | :work

filamento(m<mood>) ⇒ <string>
├ :think ⇒ "prompt >_"
├ :ready ⇒ "sonrisa abierta"
├ :work  ⇒ "ojos firmes, boca activa"
├ :sleep ⇒ "ojos cerrados"
├ :tired ⇒ "ojos caídos"
├ :lost  ⇒ "ojos en X"
└ :hold  ⇒ "zigzag de falla".

brillo(m<mood>) ⇒ <string>
├ :think ⇒ "#39e6ff"
├ :ready ⇒ "#7CFC9A"
├ :work  ⇒ "#D4AF37"
├ :sleep ⇒ "#4060ff"
├ :tired ⇒ "#ffb347"
├ :lost  ⇒ "#888888"
└ :hold  ⇒ "#ff3355".

-- La cara solo lee estado (autoridad æ1). Evidence ≠ Authority. Human stays root.
