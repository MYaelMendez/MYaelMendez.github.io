{
  "system": "æ://",
  "version": "2026-10-07",
  "description": "What each agent can do — read before dispatching",
  "agents": {
    "fleet_orchestrator": {
      "path": "C:/æ/agents/fleet_orchestrator.py",
      "modes": {
        "audit": "fleet audit <path> — scan codebase for ESM issues, :any, imports, type-safety gaps",
        "self-improve": "fleet self-improve — audit agents themselves → plan → commit → QR receipt",
        "verify": "fleet verify <files> — verify files with tsc, node --check, CDP, SupervisorVideo"
      },
      "can": ["scan codebases", "detect type gaps", "batch repair", "GPU-verify receipts"],
      "cannot": ["modify hardware", "access secrets", "bypass supervision gates"]
    },
    "zeus_engine": {
      "path": "C:/æ/agents/zeus_engine.py",
      "modes": {
        "code": "zeus code <path> — scan → repair → verify → commit → GPU receipt",
        "video": "zeus video <path> — SupervisorVideo gate → receipt"
      },
      "can": [":any detection", "batch type repair", "tsc verification", "GPU-verified commits"],
      "cannot": ["fix logic bugs", "design new features", "override human decisions"]
    },
    "hermes_supervision": {
      "path": "C:/æ/agents/hermes_supervision.py",
      "modes": {
        "selftest": "hermes_supervision.py selftest — 5/5 verification",
        "verify": "hermes_supervision.py verify <artifact> — produce-and-verify gate"
      },
      "can": ["verify Python", "verify JSON", "verify HTML/JS", "gate artifacts"],
      "cannot": ["modify artifacts", "bypass verification", "issue receipts without evidence"]
    },
    "conductor": {
      "path": "C:/æ/agents/conductor.py",
      "can": ["route æ:// schemes", "dispatch to agents", "manage MCP surface"],
      "cannot": ["modify core", "bypass kænbæn", "act without receipt"]
    }
  },
  "constraints": {
    "secrets": "MUST stay local (Victus); never in cloud links/uploads",
    "github_io": "surface truth only, not secret store",
    "evidence": "≠ Authority — supervision informs, human decides",
    "qr": "the chip — scannable/verifiable/hash-chained"
  }
}
